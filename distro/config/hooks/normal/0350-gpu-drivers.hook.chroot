#!/bin/sh
# Install the ISO's boot-time graphics selector and stage optional drivers.
set -eu

log() { printf '==> gpu-drivers: %s\n' "$1"; }

POOL=/usr/share/gnuchanos/gpu-pool
SELECTOR=/usr/local/sbin/gnuchan-gpu-select
UNIT=gnuchan-gpu-select.service

# live-build may run hooks from a temporary directory, so use the staged source
# path. The sibling path remains useful when the hook is run manually.
SELECTOR_SOURCE=/opt/gnuchanos/gnuchan-gpu-select.sh
if [ ! -f "$SELECTOR_SOURCE" ]; then
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    SELECTOR_SOURCE=$SCRIPT_DIR/gnuchan-gpu-select.sh
    if [ ! -f "$SELECTOR_SOURCE" ]; then
        log "ERROR: missing selector source at /opt/gnuchanos/gnuchan-gpu-select.sh and $SELECTOR_SOURCE"
        exit 1
    fi
fi
install -d /usr/local/sbin
install -m 0755 "$SELECTOR_SOURCE" "$SELECTOR"
log "installed $SELECTOR"

cat > "/etc/systemd/system/$UNIT" <<'UNIT_FILE'
[Unit]
Description=Bring up the graphics driver selected in the ISO boot menu
DefaultDependencies=no
After=systemd-modules-load.service local-fs.target
Before=gnuchandm.service display-manager.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gnuchan-gpu-select

[Install]
WantedBy=multi-user.target
UNIT_FILE
log "wrote /etc/systemd/system/$UNIT"

if ! systemctl enable "$UNIT"; then
    log "ERROR: could not enable $UNIT"
    exit 1
fi
log "enabled $UNIT"

# Download each driver and its dependency closure into a family-specific pool.
# This never installs proprietary packages into the built image. The common
# pool contains only DKMS/build/kernel-header dependencies.
install -d "$POOL"
log "staging optional driver packages into $POOL"

stage() {
    package=$1
    destination=$2
    install -d "$destination/partial"
    if apt-get -o "Dir::Cache::archives=$destination" \
            install -y --no-install-recommends --download-only "$package"; then
        log "staged $package and its dependencies"
    else
        log "$package is unavailable during the build; the live selector will try apt"
    fi
}

stage nvidia-driver "$POOL/nvidia"
stage nvidia-legacy-470xx-driver "$POOL/nvidia-legacy"
for package in linux-headers-amd64 dkms build-essential; do
    stage "$package" "$POOL/common"
done

log "done"
